{
  "compilerOptions": {
      "module": "node16",
      "target": "es6",
      "rootDir": "./api",
      "outDir": "./dist",
      "moduleResolution": "node16",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "strict": false,
      "paths": {
        "api/*": ["./api/*"]
      }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}

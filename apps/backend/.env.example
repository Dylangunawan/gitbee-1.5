# Copy to `.env` for direct backend development,
# or generate it from the root shared env with `pnpm env:sync`.
PORT=5001
DATABASE_URL=mysql://root:admin@localhost:3306/gitbee
WEB_URL=http://localhost:8000
JWT_SECRET=change-me
COOKIE_NAME=gitbee_token
# Trailing slash is required because the service appends route fragments.
BLUEJACK_API=
ATLANTIS_API=
# Optional extra generated users added by `prisma db seed`.
SEED_DUMMY_STUDENTS=0
SEED_DUMMY_STAFF=0

{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}

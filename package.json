{
  "name": "gitbee",
  "version": "1.0.0",
  "private": true,
  "description": "GitBee monorepo — Next.js frontend (apps/frontend) + Express/Prisma backend (apps/backend)",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "env:sync": "node ./scripts/sync-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "turbo run start",
    "dev:backend": "pnpm --filter gitbee_backend dev",
    "dev:frontend": "pnpm --filter gitbee-frontend dev",
    "build:backend": "pnpm --filter gitbee_backend build",
    "build:frontend": "pnpm --filter gitbee-frontend build"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}

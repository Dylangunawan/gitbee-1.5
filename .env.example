# Shared environment template for the whole monorepo.
# Copy this file to `.env`, then run `pnpm env:sync`.

# General
NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=gitbee
MYSQL_PORT=3306

# Host development ports
BACKEND_PORT=5001
FRONTEND_PORT=8000

# Container-only backend settings
BACKEND_CONTAINER_PORT=5000
DATABASE_URL_DOCKER=mysql://root:admin@mysql:3306/gitbee

# Local backend settings
DATABASE_URL=mysql://root:admin@localhost:3306/gitbee
WEB_URL=http://localhost:8000
JWT_SECRET=change-me
COOKIE_NAME=gitbee_token
BLUEJACK_API=
ATLANTIS_API=

# Frontend public settings
# Trailing slash is required.
NEXT_PUBLIC_BACKEND_API=http://localhost:5001/api/
NEXT_PUBLIC_CLIENT_ID=
# Use the full Microsoft authority URL, for example:
# https://login.microsoftonline.com/<tenant-id>
NEXT_PUBLIC_TENANT_ID=
NEXT_PUBLIC_REDIRECT_URI=http://localhost:8000/login
NEXT_PUBLIC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/login
NEXT_PUBLIC_STORE_AUTH_STATE_IN_COOKIE=false
NEXT_PUBLIC_CACHE_LOCATION=sessionStorage

# Optional Docker behavior
SEED_ON_BOOT=false

# Optional extra generated users added by `prisma db seed` (on top of the
# fixed seed data). All use the password GitbeeDummy#2026.
SEED_DUMMY_STUDENTS=0
SEED_DUMMY_STAFF=0
